<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>ts2cs</AssemblyName>
    <RootNamespace>TreeSitter.Generator</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Description>ts2cs: converts a generated tree-sitter grammar (src/parser.c) into C# code for TreeSitter.Managed.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ts2cs</ToolCommandName>
    <!-- A tool package carries its .pdb files itself; no separate symbol package. -->
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TreeSitter.Managed/TreeSitter.Managed.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TreeSitter.Managed.Tests" />
  </ItemGroup>
</Project>
